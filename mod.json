{
	"geode": "6.0.0",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"version": "v1.2.0",
	"id": "zher14.input-indicator",
	"name": "Input Indicator",
	"developer": "Zher14",
	"description": "Indicador minimalista de clicks con barras verticales de clicks y releases, CPS y contador.",
	"tags": ["utility", "interface"],
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Activado",
			"default": true
		},
		"opacity": {
			"type": "float",
			"name": "Opacidad",
			"default": 0.9,
			"min": 0.1,
			"max": 1.0
		},
		"scale": {
			"type": "float",
			"name": "Tamaño",
			"default": 1.0,
			"min": 0.5,
			"max": 2.0
		},
		"pos-x": {
			"type": "float",
			"name": "Posición X (%)",
			"default": 4.0,
			"min": 0.0,
			"max": 100.0
		},
		"pos-y": {
			"type": "float",
			"name": "Posición Y (%)",
			"default": 30.0,
			"min": 0.0,
			"max": 100.0
		},
		"window": {
			"type": "float",
			"name": "Duración de la barra (s)",
			"default": 1.5,
			"min": 0.5,
			"max": 5.0
		},
		"timeline": {
			"type": "bool",
			"name": "Mostrar barra de clicks",
			"default": true
		},
		"show-cps": {
			"type": "bool",
			"name": "Mostrar CPS",
			"default": true
		},
		"show-total": {
			"type": "bool",
			"name": "Mostrar clicks totales",
			"default": true
		}
	}
}