{
	"geode": "6.0.0",
	"gd": {
		"win": "2.2091",
		"android": "2.2091",
		"mac": "2.2091",
		"ios": "2.2091"
	},
	"version": "v1.0.0",
	"id": "zher14.input-indicator",
	"name": "input indicator",
	"developer": "zher14",
	"description": "This mod displays your clicks on screen, allowing you to configure them to your liking.",
	"tags": ["utility", "interface"],
	"settings": {
		"enabled": {
			"type": "bool",
			"name": "Activado",
			"default": true
		},
		"opacity": {
			"type": "float",
			"name": "Opacidad",
			"default": 0.8,
			"min": 0.1,
			"max": 1.0
		},
		"scale": {
			"type": "float",
			"name": "Tamaño",
			"default": 1.0,
			"min": 0.5,
			"max": 2.0
		},
		"pos-x": {
			"type": "float",
			"name": "Posición X (%)",
			"default": 12.0,
			"min": 0.0,
			"max": 100.0
		},
		"pos-y": {
			"type": "float",
			"name": "Posición Y (%)",
			"default": 15.0,
			"min": 0.0,
			"max": 100.0
		},
		"show-cps": {
			"type": "bool",
			"name": "Mostrar CPS",
			"default": true
		},
		"show-total": {
			"type": "bool",
			"name": "Mostrar clicks totales",
			"default": true
		}
	}
}
